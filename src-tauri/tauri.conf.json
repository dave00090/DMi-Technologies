{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "DMi Technologies POS",
  "version": "3.5.0",
  "identifier": "com.dmitechnologies.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DMi Technologies POS",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "DMi Technologies",
    "category": "Business",
    "shortDescription": "DMi POS Desktop",
    "longDescription": "DMi Point of Sale System with Automatic Desktop 24-Hour Backup",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
